# Copia questo file in .env (cp env.plesk.example .env) e compila i valori.
# Il file .env non va mai condiviso né caricato su GitHub (è già escluso).

NEXTAUTH_URL=https://reply.profdigitale.online
# Porta locale verso cui Plesk inoltra le richieste. Cambiala solo se la 3000 è già occupata.
OPENREPLY_PORT=3000

# Chiavi segrete: si generano in automatico con il comando della guida.
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
CRON_SECRET=
# Esattamente 64 caratteri esadecimali. Non cambiarla dopo il primo avvio.
ENCRYPTION_KEY=

# Solo tu puoi accedere alla dashboard
ALLOWED_EMAILS=mailprofdigitale@gmail.com

# Email del link di accesso via Gmail: serve una "password per le app" di Google
# (Account Google > Sicurezza > Verifica in 2 passaggi > Password per le app).
# La @ dell'indirizzo va scritta %40.
EMAIL_SERVER=smtps://mailprofdigitale%40gmail.com:PASSWORD_PER_APP_SENZA_SPAZI@smtp.gmail.com:465
EMAIL_FROM=OpenReply <mailprofdigitale@gmail.com>

# Dall'app Meta
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
# Generato in automatico; lo stesso valore va incollato nella configurazione webhook di Meta.
WEBHOOK_VERIFY_TOKEN=
